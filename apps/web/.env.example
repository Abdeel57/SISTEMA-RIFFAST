# ─────────────────────────────────────────────
# Web — variables de entorno (ejemplo)
# Copia a .env.local y ajusta.
# ─────────────────────────────────────────────

# URL base de la API.
# En desarrollo usa el proxy de Vite con "/api" (recomendado, comparte cookies).
# En producción la API vive en /api del mismo servicio.
VITE_API_URL=/api

# Nombre de la marca del desarrollador (pie de página).
VITE_BRAND_NAME=Riffast

# WhatsApp de Riffast para el pie "Desarrollado por Riffast".
# Número con código de país, sin "+". Ej: 5216621234567. Vacío = sin botón.
VITE_RIFFAST_WHATSAPP=

# Chat de atención 24 h dentro del administrador (burbuja «Asistencia»).
# URL de la ventana de chat que se carga dentro del panel. Vacío = la burbuja
# ofrece escribir por WhatsApp a VITE_RIFFAST_WHATSAPP.
VITE_SUPPORT_CHAT_URL=

# ─────────────────────────────────────────────
# Monitoreo de errores (Sentry) — opcional. Vacío = desactivado.
# ─────────────────────────────────────────────
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────
# Analítica de producto (PostHog) — opcional. Vacío = desactivado.
# ─────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
